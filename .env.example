# Copy this file to .env (and load it, e.g. via `dotenv` or your process manager) or
# export these directly in your shell before running `node server.js`.

# Required. Basic-auth credentials — the server refuses to start if either is unset.
AUTH_USER=
AUTH_PASS=

# Optional. Defaults to 3000.
PORT=3000

# Optional. If both are set, the server listens over HTTPS instead of plain HTTP.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional. Structured (pino) log level. Defaults to info.
LOG_LEVEL=info

# Optional. Rate limiting, applied to every request (also mitigates basic-auth
# brute-forcing). Defaults: 300 requests per 15-minute window per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional. Upload limits. Defaults: 200MB per file, 20 files per request.
UPLOAD_MAX_FILE_SIZE_MB=200
UPLOAD_MAX_FILES=20
